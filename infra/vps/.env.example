# Copy to .env (git-ignored) and fill in, so you do not retype the arguments.
# Both scripts read it; command-line arguments override it.
DOMAIN=example.com
EMAIL=you@example.com            # setup-server.sh: Let's Encrypt notices
SSH_TARGET=deploy@203.0.113.10   # deploy.sh: user@server
WEB_ROOT=/var/www/portfolio      # folder served by Nginx
